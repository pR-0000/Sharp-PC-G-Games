* text=auto
*.asm text eol=lf
*.inc text eol=lf
*.py text eol=lf
*.pyw text eol=lf
*.md text eol=lf
# Preserve Intel HEX bytes so manifest hashes stay valid after checkout.
*.hex -text whitespace=cr-at-eol
*.ihx -text whitespace=cr-at-eol
*.cmd text eol=crlf
*.bin binary
*.bmp binary
*.png binary
*.gif binary
