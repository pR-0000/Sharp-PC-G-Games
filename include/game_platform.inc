; Public IOCS/display adapter for shared game sources. Emits no data.
; FR/EN: TARGET_G850=1 selects G850; default retains the G801/G805 profile.
; No internal G805 firmware addresses are imported into a G850 build.
    IFNDEF TARGET_G850
TARGET_G850 EQU 0
    ENDIF
